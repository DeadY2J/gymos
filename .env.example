# Sin ninguna variable, GymOS funciona en modo demo con socios ficticios.
# En cuanto configuras una integración real (Mercado Pago, WhatsApp o IA), el panel exige GYMOS_TOKEN.

# ── Acceso al panel (obligatorio con cualquier integración real, 16+ caracteres) ──
GYMOS_TOKEN=
# Secreto para firmar los QR de acceso (32+ caracteres). Obligatorio fuera del modo demo.
GYMOS_SECRETO_QR=
# URL pública (https) para los avisos de Mercado Pago, p. ej. https://gymos.vercel.app
GYMOS_URL_PUBLICA=
# Quién firma los mensajes a los socios (por defecto, "el equipo de <gimnasio>").
GYMOS_REMITENTE_NOMBRE=

# ── Mercado Pago (opcional): enlace de pago y suscripción mensual ──
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de las notificaciones (Tus integraciones → Webhooks). Sin ella, el webhook rechaza todo.
MERCADOPAGO_WEBHOOK_SECRET=

# ── WhatsApp Cloud API (opcional): plantilla de retención aprobada por Meta, con el nombre como {{1}} ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PLANTILLA_RETENCION=
WHATSAPP_PLANTILLA_IDIOMA=es

# ── IA para rutinas (opcional): cualquier API compatible con OpenAI (OmniRoute, OpenAI, Claude…) ──
IA_API_KEY=
IA_BASE_URL=
IA_MODELO=
